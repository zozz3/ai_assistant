# English Speaking Coach - 环境配置

# ===========================================
# 阿里云 DashScope API 配置（必需）
# ===========================================
# 用于 ASR 语音识别和 TTS 语音合成
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ===========================================
# OpenAI API 配置（必需）
# ===========================================
# 用于 LLM 对话生成
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI API 基础 URL（可选，默认使用官方 API）
OPENAI_BASE_URL=https://api.openai.com/v1

# ===========================================
# 服务器配置
# ===========================================
HOST=0.0.0.0
PORT=8000

# 允许的 CORS 源（多个用逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# 阿里云万相数字人配置（可选）
# ===========================================
# 如果不使用数字人功能，可以留空
AVATAR_APP_ID=your-avatar-app-id
AVATAR_SERVER_USER_ID=your-server-user-id

# ===========================================
# TTS 音色配置
# ===========================================
# 中文音色：af_zhixiaobai_oral（默认）、zhixiaobai_oral、zhiyan_oral
# 英文音色：en_us_male_mix、en_us_female_clarity、en_us_male_casual
DEFAULT_TTS_VOICE=af_zhixiaobai_oral

# ===========================================
# LLM 模型配置
# ===========================================
# 推荐：gpt-4o-mini（速度快）、gpt-4o（效果好）
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500
