# Simli + LiveKit 实时数字人 Agent Worker 配置
# 复制此文件为 backend/avatar_agents/.env，然后填入真实值
# 注意：.env 已在 .gitignore 中，请勿提交！

# ===== Simli 凭证 =====
# 从 https://www.simli.com/ 注册 → Profile → API Key
SIMLI_API_KEY=simli_your_key_here
# 从 https://www.simli.com/characters 选一个角色 → 复制 Face ID
SIMLI_FACE_ID=your_face_id_here

# ===== LiveKit 云服务凭证 =====
# 注册 https://cloud.livekit.io/ → 新建项目 → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== OpenAI Realtime API（用作 LLM）=====
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
