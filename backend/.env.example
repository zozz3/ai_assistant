# ============================================
# English Speaking Coach Backend .env 模板
# ============================================
# 复制本文件为 backend/.env，填入真实凭证后重启后端。
#
# 当前 Avatar 方案：Simli P2P（浏览器 ↔ Simli 云 WebRTC 直连）
# 因此 **不需要 LiveKit 凭证**，无需再配置 LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET。
#
# Simli 凭证通过前端配置页 (SettingsPage → Avatar) 写入
# backend/config_data/avatar_config.json，包括：
#   - provider: "simli"
#   - simli_api_key: 以 "simli_" 开头的 key（去 https://app.simli.com/apiKey 复制）
#   - simli_face_id: UUID（去 https://app.simli.com/characters 选一个角色）

# 可选：阿里云 ASR / TTS / LLM 凭证（走 DashScope）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
ALIBABA_CLOUD_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
ALIBABA_CLOUD_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：DeepSeek LLM
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx